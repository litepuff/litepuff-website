# Application
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://litepuff.in
BACKEND_URL=https://litepuff.in
APP_URL=https://litepuff.in
VITE_API_BASE_URL=https://litepuff.in/api
VITE_SITE_URL=https://litepuff.in

# Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_ROLE=super_admin
ADMIN_NOTIFY_EMAIL=

# Authentication and sessions
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
OTP_SECRET=
OTP_EXPIRES_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_LOCK_MINUTES=15
OTP_CLEANUP_INTERVAL_MINUTES=5

# Google Sheets
GOOGLE_SHEET_ID=
# Preferred cross-platform sources (highest priority first)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_BASE64=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Legacy fallback
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_CERT_URL=
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_PRIVATE_KEY_ID=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
EMAIL_LOGO_URL=https://litepuff.in/favicon.png

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
META_API_VERSION=v23.0
WHATSAPP_AUTH_TEMPLATE=litepuff_authentication
WHATSAPP_ORDER_TEMPLATE=litepuff_order_confirmation
WHATSAPP_SHIPPING_TEMPLATE=litepuff_shipping_update
WHATSAPP_MARKETING_TEMPLATE=litepuff_marketing
WHATSAPP_AUTH_CODE_BUTTON=true
WHATSAPP_TIMEOUT_MS=10000
WHATSAPP_MAX_RETRIES=2

# Razorpay
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shipping
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
DELHIVERY_TOKEN=
DELHIVERY_CLIENT_NAME=
SHIPPING_ORIGIN_PINCODE=
SHIPPING_DEFAULT_WEIGHT_KG=0.5

# Brand and support
COMPANY_NAME=LitePuff
SUPPORT_EMAIL=
SUPPORT_PHONE=
WHATSAPP_NUMBER=
GST_NUMBER=
BUSINESS_ADDRESS=
VITE_BUSINESS_ADDRESS=
INSTAGRAM_URL=
